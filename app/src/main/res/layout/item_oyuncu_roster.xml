<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_oyuncu_kart"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvOyuncuHarf"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_harf_avatar"
        android:gravity="center"
        android:text="M"
        android:textColor="#F5F3EC"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOyuncuIsim"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:text="Mustafa"
        android:textColor="#16201C"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Sil butonu -->
    <ImageView
        android:id="@+id/ivOyuncuSil"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="#C0392B"
        android:contentDescription="Oyuncuyu Sil" />
</LinearLayout>
