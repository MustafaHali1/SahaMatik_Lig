<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:elevation="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Oyuncu Avatar / Harf -->
    <androidx.cardview.widget.CardView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#0F3D2E"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp">

        <TextView
            android:id="@+id/tvOyuncuHarf"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="A"
            android:textColor="#C7A233"
            android:textSize="24sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- Oyuncu İsim -->
    <TextView
        android:id="@+id/tvOyuncuIsim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oyuncu Adı"
        android:textColor="#0F3D2E"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Oyuncu Mevki ve Takım -->
    <TextView
        android:id="@+id/tvOyuncuMevki"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Forvet • Takım"
        android:textColor="#5B6660"
        android:textSize="13sp" />

    <!-- İstatistik Kartları Satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Gol -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_input"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽ Gol"
                android:textColor="#5B6660"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGolSayisi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#0F3D2E"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sarı Kart -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_input"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟨 Sarı"
                android:textColor="#5B6660"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSariSayisi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#C7A233"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kırmızı Kart -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_input"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟥 Kırmızı"
                android:textColor="#5B6660"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKirmiziSayisi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#C0392B"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kapat Butonu -->
    <TextView
        android:id="@+id/btnKapat"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_dialog_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Kapat"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
