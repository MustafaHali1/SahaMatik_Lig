<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Başlık -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Yeni Lig Oluştur (1/2)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- ================= ADIM 1: LİG ADI & TAKIM SAYISI ================= -->
    <LinearLayout
        android:id="@+id/layoutStep1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etLeagueName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lig Adı (Örn: Sultanbeyli Ligi)"
            android:inputType="textCapWords"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etTeamCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Takım Sayısı (Örn: 4)"
            android:inputType="number"/>
    </LinearLayout>

    <!-- ================= ADIM 2: DİNAMİK TAKIM İSİMLERİ (Başta Gizli) ================= -->
    <ScrollView
        android:id="@+id/layoutStep2"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:visibility="gone">

        <!-- Takım isimleri girdileri buraya kodla eklenecek -->
        <LinearLayout
            android:id="@+id/containerTeams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>