<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_oyuncu_kart"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Üst Tutma Çubuğu -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#DCD7CA" />

    <!-- Oyuncu Bilgisi Başlığı -->
    <TextView
        android:id="@+id/tvOlayOyuncuAdi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mustafa (Alshabab)"
        android:textColor="#16201C"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="Maç olayı ekle:"
        android:textColor="#5B6660"
        android:textSize="13sp" />

    <!-- 1. GOL EKLE -->
    <LinearLayout
        android:id="@+id/btnGolEkle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_format_secim_kart"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚽"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Gol (+1 Skor)"
            android:textColor="#16201C"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. SARI KART -->
    <LinearLayout
        android:id="@+id/btnSariKart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_format_secim_kart"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟨"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Sarı Kart"
            android:textColor="#16201C"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. KIRMIZI KART -->
    <LinearLayout
        android:id="@+id/btnKirmiziKart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_format_secim_kart"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟥"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Kırmızı Kart"
            android:textColor="#16201C"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. YEDEKLE DEĞİŞTİR (Oyuncu Değişikliği) -->
    <LinearLayout
        android:id="@+id/btnOyuncuDegistir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_format_secim_kart"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvDegistirBaslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Oyuncu Değiştir (Yedekle)"
            android:textColor="#16201C"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>