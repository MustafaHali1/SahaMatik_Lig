<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <!-- Forma/Avatar dairesi ve Rozetler -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center">

        <!-- Dairesel Oyuncu Balonu -->
        <TextView
            android:id="@+id/tvFormaNo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_harf_avatar"
            android:gravity="center"
            android:text="10"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="4dp" />

        <!-- Gol Rozeti (Varsa sağ üstte) -->
        <TextView
            android:id="@+id/tvRozetGol"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_forma_balon"
            android:gravity="center"
            android:text="⚽"
            android:textSize="10sp"
            android:elevation="6dp"
            android:visibility="gone" />

        <!-- Kart Rozeti (Varsa sol üstte) -->
        <TextView
            android:id="@+id/tvRozetKart"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|start"
            android:gravity="center"
            android:text="🟨"
            android:textSize="11sp"
            android:elevation="6dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Oyuncu Adı (Sofascore Tarzı gölgeli şık yazı) -->
    <TextView
        android:id="@+id/tvOyuncuAdi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:maxWidth="75dp"
        android:text="Oyuncu"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- Mevki etiketi (Küçük) -->
    <TextView
        android:id="@+id/tvOyuncuMevki"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ORT"
        android:textColor="#DCD7CA"
        android:textSize="9sp"
        android:textStyle="bold"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2" />

</LinearLayout>
