<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="3dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <!-- Forma/Avatar dairesi ve Rozetler -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <!-- Dış Renkli Takım Çerçevesi (Border) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAvatarBorder"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#2E7D4F"
            app:cardCornerRadius="23dp"
            app:cardElevation="3dp">

            <!-- İç Avatar (Yüz Fotoğrafı veya Numara) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInnerAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#1F2A24"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <!-- Yüz Fotoğrafı (Seçilmişse) -->
                <ImageView
                    android:id="@+id/ivOyuncuFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Forma No / Baş Harf (Fotoğraf Yoksa) -->
                <TextView
                    android:id="@+id/tvFormaNo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="10"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>

        <!-- Gol Rozeti (Varsa sağ üstte, gol sayısına göre ⚽⚽⚽ uzar) -->
        <TextView
            android:id="@+id/tvRozetGol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="18dp"
            android:minHeight="18dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="-4dp"
            android:layout_marginTop="-3dp"
            android:background="@drawable/bg_forma_balon"
            android:gravity="center"
            android:text="⚽"
            android:textSize="10sp"
            android:elevation="6dp"
            android:visibility="gone" />

        <!-- Kart Rozeti (Varsa sol üstte) -->
        <TextView
            android:id="@+id/tvRozetKart"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="-2dp"
            android:gravity="center"
            android:text="🟨"
            android:textSize="11sp"
            android:elevation="6dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Oyuncu No ve İlk Adı (Örn: "10. Yiğit") -->
    <TextView
        android:id="@+id/tvOyuncuAdi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:maxWidth="80dp"
        android:text="10. Oyuncu"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- Mevki etiketi (Küçük) -->
    <TextView
        android:id="@+id/tvOyuncuMevki"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ORT"
        android:textColor="#DCD7CA"
        android:textSize="9sp"
        android:textStyle="bold"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2" />

</LinearLayout>
