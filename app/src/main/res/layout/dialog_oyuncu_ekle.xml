<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Diyalog Başlığı -->
    <TextView
        android:id="@+id/tvDialogBaslik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Yeni Oyuncu Ekle"
        android:textColor="#0F3D2E"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Oyuncu Adı Etiketi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oyuncu Adı Soyadı"
        android:textColor="#16201C"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Oyuncu Adı Input -->
    <EditText
        android:id="@+id/etOyuncuIsmi"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Örn: Kerem"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:textColor="#16201C"
        android:textSize="14sp" />

    <!-- Mevki Etiketi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mevki Seçin"
        android:textColor="#16201C"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Mevki Spinner -->
    <Spinner
        android:id="@+id/spMevki"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@android:drawable/btn_dropdown"
        android:paddingHorizontal="8dp" />

    <!-- İşlem Butonları (Kaydet / İptal) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogIptal"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="İptal"
            android:textColor="#757575" />

        <Button
            android:id="@+id/btnDialogKaydet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#0F3D2E"
            android:text="Kadroya Ekle"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>