<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Başlık -->
    <TextView
        android:id="@+id/tvDialogBaslik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="⚽ Yeni Oyuncu Ekle"
        android:textColor="#0F3D2E"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Oyuncu Adı -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oyuncu Adı Soyadı"
        android:textColor="#16201C"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etOyuncuIsmi"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_dialog_input"
        android:hint="Örn: Kerem Aktürkoğlu"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:textColor="#16201C"
        android:textColorHint="#8C9E95"
        android:textSize="14sp" />

    <!-- Mevki -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mevki Seçin"
        android:textColor="#16201C"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spMevki"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_dialog_input"
        android:paddingHorizontal="10dp" />

    <!-- Buton Satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- İptal Butonu -->
        <TextView
            android:id="@+id/btnIptal"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="İptal"
            android:textColor="#5B6660"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Kaydet Butonu -->
        <TextView
            android:id="@+id/btnKaydet"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dialog_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="Kaydet"
            android:textColor="#F5F3EC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
