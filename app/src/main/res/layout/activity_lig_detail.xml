<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3EC"
    android:orientation="vertical">

    <!-- Üst Başlık Barı (Koyu Yeşil - Standart 36dp Üst Boşluk) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F3D2E"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="14dp">

        <!-- Geri Butonu (Standart Altın Sarısı ← Geri) -->
        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="← Geri"
            android:textColor="#C7A233"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Dinamik Lig Başlığı (tvLigTitle) -->
        <TextView
            android:id="@+id/tvLigTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="Lig Detayı"
            android:textColor="#F5F3EC"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sekmeler Alanı (Sıralama - Maçlar - İstatistikler) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F3D2E"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <!-- 1. Sekme: Sıralama -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnSiralama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingVertical="10dp"
                android:text="Sıralama"
                android:textColor="#F5F3EC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorSiralama"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:background="#C7A233" />
        </LinearLayout>

        <!-- 2. Sekme: Maçlar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnMaclar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingVertical="10dp"
                android:text="Maçlar"
                android:textColor="#8C9E95"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorMaclar"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:background="#C7A233"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- 3. Sekme: İstatistikler -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnIstatistik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingVertical="10dp"
                android:text="İstatistikler"
                android:textColor="#8C9E95"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorIstatistik"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:background="#C7A233"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

    <!-- Fragment'ların Yüklendiği Alan (fragmentContainer) -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>