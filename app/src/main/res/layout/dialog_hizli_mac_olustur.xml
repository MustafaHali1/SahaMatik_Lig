<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Başlık -->
    <TextView
        android:id="@+id/tvHizliMacBaslik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="⚽ Tekil Maç Oluştur (1/3)"
        android:textColor="#0F3D2E"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- ADIM 1: Maç Başlığı ve Takım İsimleri -->
    <LinearLayout
        android:id="@+id/layoutMacAdim1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maç / Randevu Adı"
            android:textColor="#16201C"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMacAdi"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dialog_input"
            android:hint="Örn: Salı 21:00 Maçı"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp"
            android:textColor="#16201C"
            android:textColorHint="#8C9E95"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Takım (Ev Sahibi)"
            android:textColor="#16201C"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTakim1Adi"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dialog_input"
            android:hint="Örn: Yeşil Takım"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp"
            android:textColor="#16201C"
            android:textColorHint="#8C9E95"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Takım (Deplasman)"
            android:textColor="#16201C"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTakim2Adi"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_dialog_input"
            android:hint="Örn: Beyaz Takım"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp"
            android:textColor="#16201C"
            android:textColorHint="#8C9E95"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ADIM 2: 1. Takım Oyuncuları -->
    <ScrollView
        android:id="@+id/layoutMacAdim2"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTakim1KadroBilgi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="1. Takımın 7 oyuncusunu girin:"
                android:textColor="#5B6660"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT1Oyuncu1"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="🧤 Kaleci İsmi"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT1Oyuncu2"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="🛡️ Defans 1"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT1Oyuncu3"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="🛡️ Defans 2"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT1Oyuncu4"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="⚡ Orta Saha 1"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT1Oyuncu5"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="⚡ Orta Saha 2"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT1Oyuncu6"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="⚽ Forvet 1"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT1Oyuncu7"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="⚽ Forvet 2"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ADIM 3: 2. Takım Oyuncuları -->
    <ScrollView
        android:id="@+id/layoutMacAdim3"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTakim2KadroBilgi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="2. Takımın 7 oyuncusunu girin:"
                android:textColor="#5B6660"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT2Oyuncu1"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="🧤 Kaleci İsmi"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT2Oyuncu2"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="🛡️ Defans 1"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT2Oyuncu3"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="🛡️ Defans 2"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT2Oyuncu4"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="⚡ Orta Saha 1"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT2Oyuncu5"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="⚡ Orta Saha 2"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT2Oyuncu6"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="⚽ Forvet 1"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etT2Oyuncu7"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="⚽ Forvet 2"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#16201C"
                android:textColorHint="#8C9E95"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Buton Satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnHizliMacIptal"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="İptal"
            android:textColor="#5B6660"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHizliMacDevam"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dialog_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="Devam Et"
            android:textColor="#F5F3EC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
