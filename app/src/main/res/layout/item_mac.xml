<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_oyuncu_kart"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Kotlin kodunun çökmesini engelleyen gizli alan -->
    <TextView
        android:id="@+id/tvHafta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Ev Sahibi -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivEvLogo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/tvTakim1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Gedik FC"
            android:textColor="#16201C"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- VS Kutusu / Skor -->
    <TextView
        android:id="@+id/tvMacSkor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/bg_vs_kutusu"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="VS"
        android:textColor="#5B6660"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Deplasman -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTakim2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Alshabab"
            android:textColor="#16201C"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivDepLogo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@android:drawable/ic_menu_gallery" />
    </LinearLayout>
</LinearLayout>