<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Üst Satır: Başlık & Kapat -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="🔍 Kadroya Oyuncu Seç"
            android:textColor="#0F3D2E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAramaKapat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#8C9E95"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Doğrulanmış profiller arasından arayın ve ekleyin"
        android:textColor="#5B6660"
        android:textSize="12sp" />

    <!-- Arama Çubuğu (Instagram Tarzı) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_dialog_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etOyuncuAramaInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@username veya Ad Ara..."
            android:inputType="textNoSuggestions"
            android:textColor="#16201C"
            android:textColorHint="#8C9E95"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/btnAramaTemizle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#8C9E95"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Sonuçlar Listesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAramaSonuclari"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp" />

    <!-- Boş Durum Uyarısı -->
    <TextView
        android:id="@+id/tvAramaBosSonuc"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center"
        android:text="Aradığınız kullanıcı bulunamadı."
        android:textColor="#8C9E95"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
