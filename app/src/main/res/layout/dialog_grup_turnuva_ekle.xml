<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Başlık -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="🏆 Gruplu Turnuva Oluştur"
        android:textColor="#0F3D2E"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Turnuva Adı -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Turnuva / Kupa Adı"
        android:textColor="#16201C"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTurnuvaAdi"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_dialog_input"
        android:hint="Örn: Sultanbeyli Kupası"
        android:inputType="textCapWords"
        android:paddingHorizontal="12dp"
        android:textColor="#16201C"
        android:textColorHint="#8C9E95"
        android:textSize="14sp" />

    <!-- Grup Sayısı -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grup Sayısı"
        android:textColor="#16201C"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etGrupSayisi"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_dialog_input"
        android:hint="Kaç grup olsun? (Örn: 2, 4)"
        android:inputType="number"
        android:paddingHorizontal="12dp"
        android:textColor="#16201C"
        android:textColorHint="#8C9E95"
        android:textSize="14sp" />

    <!-- Takım İsimleri -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Takım İsimleri (Her satıra bir takım)"
        android:textColor="#16201C"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTakimlar"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_dialog_input"
        android:gravity="top|start"
        android:hint="Gedik FC&#10;Alshabab&#10;Yıldızlar..."
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="#16201C"
        android:textColorHint="#8C9E95"
        android:textSize="13.5sp" />

    <!-- Buton Satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- İptal Butonu -->
        <TextView
            android:id="@+id/btnIptal"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="İptal"
            android:textColor="#5B6660"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Oluştur Butonu -->
        <TextView
            android:id="@+id/btnOlustur"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dialog_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="Turnuva Başlat"
            android:textColor="#F5F3EC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
