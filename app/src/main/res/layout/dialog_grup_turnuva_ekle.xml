<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Gruplu Turnuva Oluştur"
        android:textColor="@color/primaryDark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Turnuva / Kupa Adı">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTurnuvaAdi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textColor="@color/textDark"
            android:textColorHint="@color/textSecondary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Kaç Grup Olsun? (Örn: 2, 3, 4)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etGrupSayisi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/textDark"
            android:textColorHint="@color/textSecondary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Takım İsimleri (Her satıra bir takım)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTakimlar"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:textColor="@color/textDark"
            android:textColorHint="@color/textSecondary" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
