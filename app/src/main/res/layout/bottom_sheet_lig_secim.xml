<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_oyuncu_kart"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Üst Tutma Çubuğu -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#DCD7CA" />

    <!-- Başlık -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Turnuva / Lig Formatı Seç"
        android:textColor="#16201C"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Klasik Lig Seçeneği (ID: cardKlasikLig) -->
    <LinearLayout
        android:id="@+id/cardKlasikLig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_format_secim_kart"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Klasik Lig"
                android:textColor="#16201C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tek puan tablosu. Her takım birbiriyle karşılaşır."
                android:textColor="#5B6660"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Gruplu Turnuva Seçeneği (ID: cardGrupTurnuva) -->
    <LinearLayout
        android:id="@+id/cardGrupTurnuva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_format_secim_kart"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gruplu Turnuva"
                android:textColor="#16201C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Takımlar gruplara ayrılır (A, B Grubu). İlk sıradakiler elemelere geçer."
                android:textColor="#5B6660"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tekil Maç Seçeneği (ID: cardTekilMac) -->
    <LinearLayout
        android:id="@+id/cardTekilMac"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_format_secim_kart"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚽"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tekil Maç (Halı Saha)"
                android:textColor="#16201C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lig olmadan iki takım kur, kadroları gir ve hemen maça başla."
                android:textColor="#5B6660"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>