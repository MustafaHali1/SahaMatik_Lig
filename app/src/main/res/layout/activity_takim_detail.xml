<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3EC"
    android:orientation="vertical">

    <!-- Üst Koyu Yeşil Başlık Alanı -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F3D2E"
        android:paddingHorizontal="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/btnGeri"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Takım Logo Alanı -->
            <ImageView
                android:id="@+id/ivTakimLogo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="8dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />

            <!-- Takım İsmi -->
            <TextView
                android:id="@+id/tvTakimAdi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alshabab"
                android:textColor="#F5F3EC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Lig İsmi -->
            <TextView
                android:id="@+id/tvLigAdi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sultanbeyli Ligi"
                android:textColor="#C7A233"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Mevki ve Oyuncu Listesi Alanı -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- KALECİLER -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#C7A233" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Kaleciler"
                    android:textColor="#16201C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/containerKaleciler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- DEFANSLAR -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#C7A233" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Defanslar"
                    android:textColor="#16201C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/containerDefanslar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ORTA SAHA -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#C7A233" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Orta Saha"
                    android:textColor="#16201C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/containerOrtaSaha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- FORVET -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#C7A233" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Forvet"
                    android:textColor="#16201C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/containerForvet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- + Oyuncu Ekle Butonu -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOyuncuEkle"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_btn_oyuncu_ekle"
                android:text="+ Oyuncu ekle"
                android:textAllCaps="false"
                android:textColor="#1E7A4D"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>