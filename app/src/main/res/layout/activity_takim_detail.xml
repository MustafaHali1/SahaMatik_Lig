<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3EC"
    android:orientation="vertical">

    <!-- Üst Koyu Yeşil Başlık Alanı (Geniş & Heybetli Header) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F3D2E"
        android:elevation="8dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/btnGeri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="← Geri"
            android:textColor="#C7A233"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Heybetli & Büyük Takım Logo Alanı (Dairesel Kart) -->
            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="54dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#164D3A"
                app:strokeWidth="3dp"
                app:strokeColor="#C7A233">

                <ImageView
                    android:id="@+id/ivTakimLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_harf_avatar" />
            </androidx.cardview.widget.CardView>

            <!-- Logo Değiştir İpucu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="📷 Logoyu değiştirmek için dokunun"
                android:textColor="#8CAA9A"
                android:textSize="11sp" />

            <!-- Takım İsmi (Büyük ve Heybetli) -->
            <TextView
                android:id="@+id/tvTakimAdi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="Takım Adı"
                android:textColor="#F5F3EC"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Lig İsmi (Altın Sarısı) -->
            <TextView
                android:id="@+id/tvLigAdi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lig İsmi"
                android:textColor="#C7A233"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Mevki ve Oyuncu Listesi Alanı -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- KALECİLER -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#C7A233" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Kaleciler"
                    android:textColor="#16201C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/containerKaleciler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- DEFANSLAR -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#C7A233" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Defanslar"
                    android:textColor="#16201C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/containerDefanslar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ORTA SAHA -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#C7A233" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Orta Saha"
                    android:textColor="#16201C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/containerOrtaSaha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- FORVET -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#C7A233" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Forvet"
                    android:textColor="#16201C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/containerForvet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Butonlar: Oyuncu Ekle ve Link Paylaş -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOyuncuEkle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_btn_oyuncu_ekle"
                    android:text="🔍 Kadroya Oyuncu Ara ve Ekle"
                    android:textAllCaps="false"
                    android:textColor="#1E7A4D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTakimDavetLinki"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_oyuncu_ekle"
                    android:text="🔗 WhatsApp / Davet Linki Paylaş"
                    android:textAllCaps="false"
                    android:textColor="#C7A233"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>