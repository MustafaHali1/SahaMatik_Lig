<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="10dp">

    <!-- # SIRA -->
    <TextView
        android:id="@+id/tvSira"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="#5B6660"
        android:textSize="13sp" />

    <!-- LOGO + TAKIM ADI -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EAE7DD">

            <ImageView
                android:id="@+id/ivTakimLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_harf_avatar" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvTakimAdi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Alshabab"
            android:textColor="#16201C"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- O (Oynanan) -->
    <TextView
        android:id="@+id/tvOynanan"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:textColor="#16201C"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- G (Galibiyet) -->
    <TextView
        android:id="@+id/tvGalibiyet"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:textColor="#16201C"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- B (Beraberlik) — ARTIK GÖRÜNÜR -->
    <TextView
        android:id="@+id/tvBeraberlik"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:textColor="#16201C"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- M (Mağlubiyet) -->
    <TextView
        android:id="@+id/tvMaglubiyet"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:textColor="#16201C"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- +/- (AVERAJ) -->
    <TextView
        android:id="@+id/tvAveraj"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:textColor="#16201C"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- PUAN -->
    <TextView
        android:id="@+id/tvPuan"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:textColor="#1E7A4D"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
