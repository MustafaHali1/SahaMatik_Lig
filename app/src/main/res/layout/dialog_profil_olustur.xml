<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Başlık Bölümü -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="⚽ SAHAMATİK"
            android:textColor="#C7A233"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Oyuncu Profilini Oluştur"
            android:textColor="#0F3D2E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Halı saha kariyerin için kimliğini belirle"
            android:textColor="#5B6660"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Avatar / Yüz Fotoğrafı Seçme Kartı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/containerProfilFotoSec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <androidx.cardview.widget.CardView
                android:layout_width="68dp"
                android:layout_height="68dp"
                app:cardBackgroundColor="#0F3D2E"
                app:cardCornerRadius="34dp"
                app:cardElevation="2dp">

                <ImageView
                    android:id="@+id/ivProfilFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvProfilHarf"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⚽"
                    android:textColor="#C7A233"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <!-- Kamera Rozeti -->
            <androidx.cardview.widget.CardView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                app:cardBackgroundColor="#C7A233"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="📷"
                    android:textSize="12sp" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Yüz Fotoğrafı Ekle (İsteğe Bağlı)"
            android:textColor="#5B6660"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- İsim Girişi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ad Soyad"
        android:textColor="#16201C"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etProfilIsim"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_dialog_input"
        android:hint="Örn: Ahmet Yılmaz"
        android:inputType="textPersonName|textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="#16201C"
        android:textColorHint="#8C9E95"
        android:textSize="14sp" />

    <!-- Kullanıcı Adı Girişi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Kullanıcı Adı (@username)"
        android:textColor="#16201C"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etProfilUsername"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_dialog_input"
        android:hint="@ahmet10"
        android:inputType="textNoSuggestions"
        android:paddingHorizontal="14dp"
        android:textColor="#C7A233"
        android:textColorHint="#8C9E95"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Kullanıcı Adı Durumu / Uyarı -->
    <TextView
        android:id="@+id/tvUsernameDurumUyari"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="⚠️ Bu kullanıcı adı zaten kullanılıyor!"
        android:textColor="#C0392B"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <!-- Önerilen Kullanıcı Adları -->
    <LinearLayout
        android:id="@+id/layoutUsernameOneriler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Önerilen Kullanıcı Adları:"
            android:textColor="#5B6660"
            android:textSize="11sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerOneriChipleri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Mevki Seçimi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Mevkiini Seç"
        android:textColor="#16201C"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnMevkiKaleci"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🧤 Kaleci"
            android:textColor="#5B6660"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMevkiDefans"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🛡️ Defans"
            android:textColor="#5B6660"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMevkiOrtaSaha"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_dialog_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⚡ Orta Saha"
            android:textColor="#5B6660"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMevkiForvet"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_format_secim_kart"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⚽ Forvet"
            android:textColor="#0F3D2E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Forma Numarası -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Favori Forma Numarası"
        android:textColor="#16201C"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etProfilFormaNo"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_dialog_input"
        android:hint="10"
        android:inputType="number"
        android:maxLength="2"
        android:paddingHorizontal="14dp"
        android:textColor="#16201C"
        android:textColorHint="#8C9E95"
        android:textSize="14sp" />

    <!-- Kaydet Butonu -->
    <TextView
        android:id="@+id/btnProfilKaydet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_dialog_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Profili Oluştur &amp; Başla ⚽"
        android:textColor="#FFFFFF"
        android:textSize="14.5sp"
        android:textStyle="bold" />

</LinearLayout>
