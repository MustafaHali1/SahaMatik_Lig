<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Tablo Başlıkları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="#F0F0F0">

        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="#" android:textStyle="bold" android:textColor="#000000"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="Takım" android:textStyle="bold" android:textColor="#000000"/>
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="O" android:textStyle="bold" android:gravity="center" android:textColor="#000000"/>
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="G" android:textStyle="bold" android:gravity="center" android:textColor="#000000"/>
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="B" android:textStyle="bold" android:gravity="center" android:textColor="#000000"/>
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="M" android:textStyle="bold" android:gravity="center" android:textColor="#000000"/>
        <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="+/-" android:textStyle="bold" android:gravity="center" android:textColor="#000000"/>
        <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="Puan" android:textStyle="bold" android:gravity="center" android:textColor="#000000"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPuanDurumu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>