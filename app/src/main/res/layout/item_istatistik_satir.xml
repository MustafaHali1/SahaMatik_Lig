<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="#FFFFFF"
android:gravity="center_vertical"
android:orientation="horizontal"
android:paddingHorizontal="14dp"
android:paddingVertical="12dp">

<!-- Sıra No (1, 2...) -->
<TextView
    android:id="@+id/tvSiraNo"
    android:layout_width="24dp"
    android:layout_height="wrap_content"
    android:text="1"
    android:textColor="#C7A233"
    android:textSize="14sp"
    android:textStyle="bold" />

    <!-- Takım Logosu (Dairesel Kart) -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#EAE7DD">

        <ImageView
            android:id="@+id/ivTakimLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_harf_avatar" />
    </androidx.cardview.widget.CardView>

<!-- Takım Adı -->
<TextView
    android:id="@+id/tvTakimAdi"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Alshabab"
    android:textColor="#16201C"
    android:textSize="14sp"
    android:textStyle="bold" />

<!-- Değer (Gol Sayısı) -->
<TextView
    android:id="@+id/tvDeger"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="30"
    android:textColor="#1E7A4D"
    android:textSize="16sp"
    android:textStyle="bold" />

</LinearLayout>