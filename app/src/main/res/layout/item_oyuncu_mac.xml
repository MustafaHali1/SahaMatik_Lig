<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_oyuncu_kart"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="3dp"
    android:orientation="vertical"
    android:padding="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- İsim satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Avatar dairesi -->
        <TextView
            android:id="@+id/tvHarf"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_harf_avatar"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- İsim + Mevki -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOyuncuIsim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Oyuncu İsmi"
                android:textColor="#16201C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMevki"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mevki_rozet"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="FRV"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- İstatistik satırı (gol / sarı / kırmızı) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Gol -->
        <TextView
            android:id="@+id/tvGolSayisi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚽ 0"
            android:textColor="#2E7D4F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Sarı kart -->
        <TextView
            android:id="@+id/tvSariKart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="🟨 0"
            android:textColor="#B8860B"
            android:textSize="11sp" />

        <!-- Kırmızı kart -->
        <TextView
            android:id="@+id/tvKirmiziKart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="🟥 0"
            android:textColor="#C0392B"
            android:textSize="11sp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Yedek etiketi -->
        <TextView
            android:id="@+id/tvYedekEtiketi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E8F0ED"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Yedek"
            android:textColor="#5B6660"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
