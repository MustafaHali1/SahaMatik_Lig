<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <!-- Forma/Avatar dairesi -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center">

        <TextView
            android:id="@+id/tvYedekNo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_harf_avatar"
            android:gravity="center"
            android:text="12"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Rozetler (varsa) -->
        <TextView
            android:id="@+id/tvYedekRozetGol"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_forma_balon"
            android:gravity="center"
            android:text="⚽"
            android:textSize="9sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Yedek Oyuncu İsmi -->
    <TextView
        android:id="@+id/tvYedekIsim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:maxWidth="70dp"
        android:text="Oyuncu"
        android:textColor="#F5F3EC"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Mevki etiketi -->
    <TextView
        android:id="@+id/tvYedekMevki"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YDK"
        android:textColor="#C7A233"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
